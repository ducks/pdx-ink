+  it "uses first and last initials for people without an image" do
+    DiscourseDirectory::Entry.create!(name: "Mary Jane Watson")
+    DiscourseDirectory::Entry.create!(name: "Kale")
+
+    get "/directory"
+
+    initials =
+      Nokogiri
+        .HTML5(response.body)
+        .css(".directory-card")
+        .to_h do |card|
+          [
+            card.at_css(".directory-card__title").text,
+            card.at_css(".directory-card__placeholder")&.text&.strip,
+          ]
+        end
+    expect(initials).to eq(
+      "River Stone" => nil,
+      "Sam North" => "SN",
+      "Mary Jane Watson" => "MW",
+      "Kale" => "K",
+    )
+  end
+
+  it "shows direct and shop neighborhoods separately from specialization tags" do
+    get "/directory"
+
+    document = Nokogiri.HTML5(response.body)
+    cards =
+      document.css(".directory-card").index_by { |card| card.at_css(".directory-card__title").text }
+    expect(cards[person.name].at_css(".directory-card__location").text).to eq("Mississippi")
+    expect(cards[other_person.name].at_css(".directory-card__location").text).to eq("Sellwood")
+    expect(cards[person.name].css(".directory-tags__item").map(&:text)).to eq(["Fine line"])
+    expect(document.at_css(".directory-kind-nav [aria-current='page']")["href"]).to include(
+      "kind=people",
+    )
+
+    get "/directory", params: { kind: "shops" }
+
+    document = Nokogiri.HTML5(response.body)
+    expect(document.at_css(".directory-card__location").text).to eq("Mississippi")
+    expect(document.at_css(".directory-kind-nav [aria-current='page']")["href"]).to include(
+      "kind=shops",
+    )
+  end
+
